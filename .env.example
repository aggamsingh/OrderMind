# LLM provider — "gemini" (default, free tier, hosted), "ollama" (free, local,
# but slower/CPU-bound), or "anthropic" (paid, no free tier). Switching is
# just this value + the matching credentials below. See DECISIONS.md D-3/D-4.
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=ollama. Must be already pulled (`ollama pull qwen2:7b`)
# and the Ollama server running locally (`ollama serve`).
OLLAMA_MODEL=qwen2:7b
OLLAMA_BASE_URL=http://localhost:11434

# Required if LLM_PROVIDER=gemini. Free key from aistudio.google.com.
GEMINI_API_KEY=

# Required if LLM_PROVIDER=anthropic. Not needed for the Ollama/Gemini paths.
ANTHROPIC_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required even for local dev — app/api/webhooks/razorpay throws (not a clean
# 400) on every request, forged or real, if this is unset. For a real
# Razorpay-delivered webhook you also need a public URL (ngrok/Vercel)
# registered as this secret's endpoint in the Dashboard — see BUILD_LOG.md
# Day 5. For local-only testing of the handler's own logic without that
# tunnel, any locally-generated secret works — see scripts/test-failure-flow-live.ts.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret used to sign and verify buyer-agent spend mandates and the
# signed receipts returned to them (lib/mandate.ts). Any long random string
# works for test mode; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the buyer's issuer would sign asymmetrically and this
# merchant would verify against a public key instead of a shared secret.
MANDATE_SIGNING_SECRET=

# Password for the /principal console. Stands in for a real identity provider:
# every /api/principal route derives the acting principal from the signed
# session cookie this password unlocks, never from the request body.
# Generate with: node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
PRINCIPAL_CONSOLE_PASSWORD=

# ES256 (P-256, PKCS8 PEM) private key for AP2-aligned mandates. The public
# half is published at /.well-known/jwks.json so any party can verify a
# mandate without holding a shared secret. Without this, an ephemeral key is
# generated per process — fine locally, useless across restarts.
# Generate with:
#   node -e "const c=require('crypto');const {privateKey}=c.generateKeyPairSync('ec',{namedCurve:'P-256'});console.log(JSON.stringify(privateKey.export({type:'pkcs8',format:'pem'}).toString().trim()))"
AP2_PRIVATE_KEY_PEM=

# --- Per-merchant Razorpay accounts (optional) ---
# Two storefronts sharing one balance are two storefronts; two with separate
# accounts are two businesses. Set these to give Sweet Street its own account —
# the manifest then reports settlement_account: "dedicated" instead of
# "shared_with_deployment". Unset, it falls back to the keys above and says so.
RAZORPAY_SWEET_KEY_ID=
RAZORPAY_SWEET_KEY_SECRET=

# --- Per-merchant public origins (optional) ---
# When each merchant is deployed to its own host, set these so each manifest
# advertises where it actually lives. Unset means "same origin as the request".
MERCHANT_CHAI_HOST=
MERCHANT_SWEET_HOST=
