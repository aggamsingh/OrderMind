# LLM provider — "gemini" (default, free tier, hosted), "ollama" (free, local,
# but slower/CPU-bound), or "anthropic" (paid, no free tier). Switching is
# just this value + the matching credentials below. See DECISIONS.md D-3/D-4.
LLM_PROVIDER=gemini

# Required if LLM_PROVIDER=ollama. Must be already pulled (`ollama pull qwen2:7b`)
# and the Ollama server running locally (`ollama serve`).
OLLAMA_MODEL=qwen2:7b
OLLAMA_BASE_URL=http://localhost:11434

# Required if LLM_PROVIDER=gemini. Free key from aistudio.google.com.
GEMINI_API_KEY=

# Required if LLM_PROVIDER=anthropic. Not needed for the Ollama/Gemini paths.
ANTHROPIC_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required even for local dev — app/api/webhooks/razorpay throws (not a clean
# 400) on every request, forged or real, if this is unset. For a real
# Razorpay-delivered webhook you also need a public URL (ngrok/Vercel)
# registered as this secret's endpoint in the Dashboard — see BUILD_LOG.md
# Day 5. For local-only testing of the handler's own logic without that
# tunnel, any locally-generated secret works — see scripts/test-failure-flow-live.ts.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret used to sign and verify buyer-agent spend mandates and the
# signed receipts returned to them (lib/mandate.ts). Any long random string
# works for test mode; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In production the buyer's issuer would sign asymmetrically and this
# merchant would verify against a public key instead of a shared secret.
MANDATE_SIGNING_SECRET=
